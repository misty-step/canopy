up-discovered collectors after prune=%d, want 0\", got)\napp_test.go:258: \tdiscovered := []Instance{\napp_test.go:259: \t\t{ID: \"discovered\", Label: \"Discovered\", Root: \"/tmp/discovered\", Forest: \"forest\"},\napp_test.go:261: \tapp.syncDiscoveredInstances(context.Background(), discovered)\napp_test.go:265: \t\tt.Fatalf(\"instances after first sync=%+v, want explicit plus discovered\", got)\napp_test.go:268: \t// A later discovery pass that no longer reports the discovered instance\napp.go:47: \t// discovered records instances added by auto-discovery so reconciliation\napp.go:49: \tdiscovered map[string]struct{}\napp.go:77: \t\tdiscovered: make(map[string]struct{}),\napp.go:117: \t\t\tdiscovered, err := DiscoverLocalInstances(ctx)\napp.go:118: \t\t\tif err == nil && len(discovered) > 0 {\napp.go:119: \t\t\t\ta.syncDiscoveredInstances(ctx, discovered)\napp.go:235: func (a *App) syncDiscoveredInstances(ctx context.Context, discovered []Instance) {\napp.go:239: \tdiscMap := make(map[string]Instance, len(discovered))\napp.go:240: \tfor _, disc := range discovered {\napp.go:247: \tnewInstances := make([]Instance, 0, len(a.inventory.Instances)+len(discovered))\napp.go:249: \t\tif _, wasDiscovered := a.discovered[existing.ID]; wasDiscovered {\napp.go:253: \t\t\t\t// Obsolete discovered instance: cancel and clean up worker\napp.go:259: \t\t\t\tdelete(a.discovered, existing.ID)\napp.go:266: \t// 2. Add newly discovered instances\napp.go:273: \tfor _, disc := range discovered {\napp.go:279: \t\ta.discovered[disc.ID] = struct{}{}\nagents/verifier/agent.md:2: model: openrouter/deepseek/deepseek-v4-pro-0813\nagents/tester/agent.md:2: model: openrouter/google/gemini-3.8-flash\nagents/critic/agent.md:2: model: openrouter/z-ai/glm-5.3-flash\nagents/fixer/agent.md:2: model: openrouter/deepseek/deepseek-v4-flash-0731\nagents/builder/agent.md:2: model: openrouter/meta/muse-spark-1.3-contributor"}],"isError":false,"timestamp":1788551784353}}
