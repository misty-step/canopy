order.Code, recorder.Body.String())\n \t}\n }\n+\n+func TestLogViewerTemplatesRenderDrawerAndCopyControl(t *testing.T) {\n+\ttemplates, err := loadTemplates()\n+\tif err != nil {\n+\t\tt.Fatalf(\"load templates: %v\", err)\n+\t}\n+\n+\tvar page bytes.Buffer\n+\tif err := templates.ExecuteTemplate(&page, \"page.html\", PageView{}); err != nil {\n+\t\tt.Fatalf(\"render page template: %v\", err)\n+\t}\n+\tfor _, want := range []string{`id=\"log-drawer\"`, `id=\"log-drawer-body\"`, `data-log-close`, `/static/canopy.js`} {\n+\t\tif !strings.Contains(page.String(), want) {\n+\t\t\tt.Fatalf(\"page template missing %q\", want)\n+\t\t}\n+\t}\n+\n+\tselected := InstanceView{\n+\t\tID:         \"one\",\n+\t\tFreshness:  \"fresh\",\n+\t\tLiveRuns:   []LiveRunViewModel{{RunID: \"live-1\", Agent: \"builder\"}},\n+\t\tRecentRuns: []RunViewModel{{RunID: \"recent-1\", ExitLabel: \"exit 0\", Status: \"passed\"}},\n+\t}\n+\tvar instanceHTML bytes.Buffer\n+\tif err := templates.ExecuteTemplate(&instanceHTML, \"instance.html\", selected); err != nil {\n+\t\tt.Fatalf(\"render instance template: %v\", err)\n+\t}\n+\tfor _, want := range []string{`data-log-open`, `hx-target=\"#log-drawer-body\"`} {\n+\t\tif !strings.Contains(instanceHTML.String(), want) {\n+\t\t\tt.Fatalf(\"instance template missing %q\", want)\n+\t\t}\n+\t}\n+\n+\texit := 0\n+\tvar log bytes.Buffer\n+\tif err := templates.ExecuteTemplate(&log, \"log.html\", LogView{RunID: \"run-1\", State: \"retained\", Text: \"line one\", Exit: &exit}); err != nil {\n+\t\tt.Fatalf(\"render log template: %v\", err)\n+\t}\n+\tfor _, want := range []string{`data-log-copy`, \"run-1\", \"line one\"} {\n+\t\tif !strings.Contains(log.String(), want) {\n+\t\t\tt.Fatalf(\"log template missing %q\", want)\n+\t\t}\n+\t}\n+}\ndiff --git a/static/canopy.css b/static/canopy.css\nindex 72ab388..53ed51f 100644\n--- a/static/canopy.css\n+++ b/static/canopy.css\n@@ -210,9 +210,94 @@ h3 { margin-bottom: .45rem; font-size: .98rem; color: var(--ink); }\n .signal.running { color: var(--evergreen); background: #e2f1e4; }\n \n .log-link { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .8rem; }\n-.log-drawer { margin-top: .8rem; padding: .9rem; background: #172c27; color: #edf5ec; border-radius: .45rem; }\n-.log-drawer pre { max-height: 24rem; margin: .6rem 0 0; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; font: .8rem/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }\n-.log-drawer .muted { color: #b4c7b9; }\n+\n+.log-drawer {\n+  --log-gutter: 1.25rem;\n+  position: fixed;\n+  inset: 0;\n+  z-index: 50;\n+  display: grid;\n+  grid-template-columns: minmax(0, 1fr) minmax(22rem, 40rem);\n+}\n+.log-drawer[hidden] { display: none; }\n+.log-drawer-backdrop {\n+  grid-column: 1 / -1;\n+  grid-row: 1;\n+  background: rgba(15, 45, 36, .48);\n+}\n+.log-drawer-panel {\n+  grid-column: 2;\n+  grid-row: 1;\n+  display: flex;\n+  flex-direction: column;\n+  min-height: 0;\n+  background: var(--surface);\n+  border-left: 1px solid var(--line-strong);\n+  box-shadow: var(--shadow);\n+}\n+.log-drawer-header {\n+  display: flex;\n+  align-items: center;\n+  justify-content: space-between;\n+  gap: 1rem;\n+  padding: 1rem var(--log-gutter);\n+  border-bottom: 1px solid var(--line);\n+}\n+.log-drawer-header h2 { margin: 0; }\n+.log-drawer-close {\n+  font: inherit;\n+  color: var(--ink);\n+  background: #ffffff;\n+  border: 1px solid var(--line-strong);\n+  border-radius: .45rem;\n+  padding: .42rem .72rem;\n+  cursor: pointer;\n+}\n+.log-drawer-close:hover { border-color: var(--evergreen); color: var(--evergreen); }\n+.log-drawer-body {\n+  display: flex;\n+  flex-direction: column;\n+  flex: 1;\n+  min-height: 0;\n+  padding: var(--log-gutter);\n+}\n+.log-pane { display: flex; flex: 1; flex-direction: column; gap: .9rem; min-height: 0; }\n+.log-pane-meta {\n+  display: flex;\n+  flex-wrap: wrap;\n+  align-items: center;\n+  justify-content: space-between;\n+  gap: .6rem;\n+  padding-bottom: .8rem;\n+  border-bottom: 1px solid var(--line);\n+}\n+.log-run-id { font-size: .78rem; color: var(--muted); }\n+.log-copy {\n+  font: inherit;\n+  font-size: .82rem;\n+  color: var(--ink);\n+  background: #ffffff;\n+  border: 1px solid var(--line-strong);\n+  border-radius: .4rem;\n+  padding: .34rem .64rem;\n+  cursor: pointer;\n+}\n+.log-copy:hover { border-color: var(--evergreen); color: var(--evergreen); }\n+.log-copy:disabled { cursor: default; opacity: .7; }\n+.log-text {\n+  flex: 1;\n+  min-height: 14rem;\n+  margin: 0;\n+  padding: 1rem 1.1rem;\n+  overflow: auto;\n+  white-space: pre-wrap;\n+  overflow-wrap: anywhere;\n+  background: var(--evergreen-dark);\n+  color: #edf5ec;\n+  border-radius: .55rem;\n+  font: .8rem/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n+}\n+.log-drawer .muted { color: var(--muted); }\n \n @media (max-width: 850px) {\n   .app-shell { display: block; }\n@@ -224,6 +309,13 @@ h3 { margin-bottom: .45rem; font-size: .98rem; color: var(--ink); }\n   .card-half, .card-third { grid-column: span 12; }\n   .page-header { align-items: start; flex-direction: column; }\n   .data-table-wrap .data-table { min-width: 42rem; }\n+  .log-drawer { grid-template-columns: minmax(0, 1fr) minmax(18rem, 34rem); }\n+}\n+\n+@media (max-width: 560px) {\n+  .log-drawer { grid-template-columns: 1fr; }\n+  .log-drawer-panel { grid-column: 1; }\n+  .log-drawer-backdrop { display: none; }\n }\n \n @media (prefers-reduced-motion: reduce) {\ndiff --git a/static/canopy.js b/static/canopy.js\nnew file mode 100644\nindex 0000000..0e47167\n--- /dev/null\n+++ b/static/canopy.js\n@@ -0,0 +1,148 @@\n+(function () {\n+  \"use strict\";\n+\n+  var lastTrigger = null;\n+\n+  function drawer() {\n+    return document.getElementById(\"log-drawer\");\n+  }\n+\n+  function body() {\n+    return document.getElementById(\"log-drawer-body\");\n+  }\n+\n+  function openDrawer(trigger) {\n+    var panel = drawer();\n+    if (!panel) {\n+      return;\n+    }\n+    var content = body();\n+    if (content) {\n+      content.innerHTML = '<p class=\"muted\">Loading log\\u2026</p>';\n+    }\n+    lastTrigger = trigger || null;\n+    panel.hidden = false;\n+    var closeButton = panel.querySelector(\".log-drawer-close\");\n+    if (closeButton) {\n+      closeButton.focus();\n+    }\n+  }\n+\n+  function closeDrawer() {\n+    var panel = drawer();\n+    if (!panel) {\n+      return;\n+    }\n+    panel.hidden = true;\n+    var content = body();\n+    if (content) {\n+      content.innerHTML = \"\";\n+    }\n+    var restore = lastTrigger && document.contains(lastTrigger)\n+      ? lastTrigger\n+      : document.getElementById(\"main-content\");\n+    if (restore && typeof restore.focus === \"function\") {\n+      restore.focus();\n+    }\n+    lastTrigger = null;\n+  }\n+\n+  function copyLog(button) {\n+    var pane = button.closest(\".log-pane\");\n+    var text = pane ? pane.querySelector(\".log-text\") : null;\n+    var value = text ? text.textContent : \"\";\n+    copyText(value).then(function (copied) {\n+      if (!copied) {\n+        return;\n+      }\n+      var label = button.textContent;\n+      button.textContent = \"Copied\";\n+      button.disabled = true;\n+      window.setTimeout(function () {\n+        button.textContent = label;\n+        button.disabled = false;\n+      }, 1200);\n+    });\n+  }\n+\n+  function copyText(value) {\n+    if (navigator.clipboard && window.isSecureContext) {\n+      return navigator.clipboard.writeText(value).then(\n+        function () { return true; },\n+        function () { return legacyCopy(value); }\n+      );\n+    }\n+    return Promise.resolve(legacyCopy(value));\n+  }\n+\n+  function legacyCopy(value) {\n+    var textarea = document.createElement(\"textarea\");\n+    textarea.value = value;\n+    textarea.setAttribute(\"readonly\", \"\");\n+    textarea.style.position = \"fixed\";\n+    textarea.style.top = \"-9999px\";\n+    document.body.appendChild(textarea);\n+    var selection = document.getSelection();\n+    var range = selection && selection.rangeCount > 0 ? selection.getRangeAt(0) : null;\n+    textarea.select();\n+    textarea.setSelectionRange(0, textarea.value.length);\n+    var copied = false;\n+    try {\n+      copied = document.execCommand(\"copy\");\n+    } catch (err) {\n+      copied = false;\n+    }\n+    document.body.removeChild(textarea);\n+    if (range && selection) {\n+      selection.removeAllRanges();\n+      selection.addRange(range);\n+    }\n+    return copied;\n+  }\n+\n+  document.addEventListener(\"click\", function (event) {\n+    var openLink = event.target.closest(\"[data-log-open]\");\n+    if (openLink) {\n+      if (event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey) {\n+        openDrawer(openLink);\n+      }\n+      return;\n+    }\n+    if (event.target.closest(\"[data-log-close]\")) {\n+      closeDrawer();\n+      return;\n+    }\n+    var copyButton = event.target.closest(\"[data-log-copy]\");\n+    if (copyButton) {\n+      copyLog(copyButton);\n+    }\n+  });\n+\n+  document.addEventListener(\"keydown\", function (event) {\n+    var panel = drawer();\n+    if (!panel || panel.hidden) {\n+      return;\n+    }\n+    if (event.key === \"Escape\") {\n+      closeDrawer();\n+      return;\n+    }\n+    if (event.key === \"Tab\") {\n+      var focusable = panel.querySelectorAll(\n+        'button, [href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])'\n+      );\n+      if (!focusable.length) {\n+        return;\n+      }\n+      var first = focusable[0];\n+      var last = focusable[focusable.length - 1];\n+      if (event.shiftKey && document.activeElement === first) {\n+        event.preventDefault();\n+        last.focus();\n+      } else if (!event.shiftKey && document.activeElement === last) {\n+        event.preventDefault();\n+        first.focus();\n+      }\n+    }\n+  });\n+})();\ndiff --git a/templates/instance.html b/templates/instance.html\nindex d690903..634f351 100644\n--- a/templates/instance.html\n+++ b/templates/instance.html\n@@ -56,7 +56,7 @@\n           {{if .LiveRuns}}\n             <div class=\"data-table-wrap\"><table class=\"data-table\"><thead><tr><th>Run</th><th>Agent</th><th>Started</th><th>Elapsed</th><th>Logs</th></tr></thead><tbody>\n               {{range .LiveRuns}}\n-                <tr><td class=\"mono\">{{.RunID}}</td><td>{{if .Agent}}{{.Agent}}{{else}}legacy / unnamed{{end}}</td><td class=\"mono\">{{.StartedAt}}</td><td>{{.Elapsed}}</td><td><a class=\"log-link\" href=\"/logs?instance={{$.ID}}&amp;run={{.RunID}}\" hx-get=\"/logs?instance={{$.ID}}&amp;run={{.RunID}}\" hx-target=\"next .log-output\" hx-swap=\"outerHTML\">open log</a><div id=\"log-{{.RunID}}\" class=\"log-output muted\" hx-preserve=\"true\">on demand</div></td></tr>\n+                <tr><td class=\"mono\">{{.RunID}}</td><td>{{if .Agent}}{{.Agent}}{{else}}legacy / unnamed{{end}}</td><td class=\"mono\">{{.StartedAt}}</td><td>{{.Elapsed}}</td><td><a class=\"log-link\" data-log-open href=\"/logs?instance={{$.ID}}&amp;run={{.RunID}}\" hx-get=\"/logs?instance={{$.ID}}&amp;run={{.RunID}}\" hx-target=\"#log-drawer-body\" hx-swap=\"innerHTML\">open log</a></td></tr>\n               {{end}}\n             </tbody></table></div>\n           {{else}}<p class=\"empty\">No live runs reported.</p>{{end}}\n@@ -81,7 +81,7 @@\n             <div class=\"data-table-wrap\">\n             <table class=\"data-table\"><thead><tr><th>Run</th><th>Agent</th><th>Outcome</th><th>Duration</th><th>Logs</th></tr></thead><tbody>\n               {{range .RecentRuns}}\n-                <tr><td class=\"mono\">{{.RunID}}</td><td>{{if .Agent}}{{.Agent}}{{else}}legacy / unnamed{{end}}</td><td><span class=\"signal {{if eq .Status \"passed\"}}ok{{else}}error{{end}}\">{{.ExitLabel}}</span>{{if .Error}}<br><span class=\"muted\">{{.Error}}</span>{{end}}</td><td>{{.Duration}}</td><td><a class=\"log-link\" href=\"/logs?instance={{$.ID}}&amp;run={{.RunID}}\" hx-get=\"/logs?instance={{$.ID}}&amp;run={{.RunID}}\" hx-target=\"next .log-output\" hx-swap=\"outerHTML\">open</a><div id=\"log-{{.RunID}}\" class=\"log-output muted\" hx-preserve=\"true\">on demand</div></td></tr>\n+                <tr><td class=\"mono\">{{.RunID}}</td><td>{{if .Agent}}{{.Agent}}{{else}}legacy / unnamed{{end}}</td><td><span class=\"signal {{if eq .Status \"passed\"}}ok{{else}}error{{end}}\">{{.ExitLabel}}</span>{{if .Error}}<br><span class=\"muted\">{{.Error}}</span>{{end}}</td><td>{{.Duration}}</td><td><a class=\"log-link\" data-log-open href=\"/logs?instance={{$.ID}}&amp;run={{.RunID}}\" hx-get=\"/logs?instance={{$.ID}}&amp;run={{.RunID}}\" hx-target=\"#log-drawer-body\" hx-swap=\"innerHTML\">open</a></td></tr>\n               {{end}}\n             </tbody></table>\n             </div>\ndiff --git a/templates/log.html b/templates/log.html\nindex d141ded..f163916 100644\n--- a/templates/log.html\n+++ b/templates/log.html\n@@ -1,10 +1,11 @@\n-<article id=\"log-{{.RunID}}\" class=\"log-drawer log-output\" aria-live=\"polite\">\n-  <div class=\"card-header\">\n-    <h3>Run log <span class=\"mono\">{{.RunID}}</span></h3>\n+<div class=\"log-pane\">\n+  <div class=\"log-pane-meta\">\n+    <span class=\"log-run-id mono\">{{.RunID}}</span>\n     {{if eq .State \"retained\"}}<span class=\"signal ok\">retained</span>{{else if eq .State \"evicted\"}}<span class=\"signal unknown\">not retained</span>{{else if eq .State \"unknown\"}}<span class=\"signal error\">unknown run</span>{{else}}<span class=\"signal error\">error</span>{{end}}\n+    {{if and (eq .State \"retained\") .Text}}<button type=\"button\" class=\"log-copy\" data-log-copy>Copy log</button>{{end}}\n   </div>\n   {{if eq .State \"retained\"}}\n-    {{if .Text}}<pre>{{.Text}}</pre>{{else}}<p class=\"muted\">The retained log is empty.</p>{{end}}\n+    {{if .Text}}<pre class=\"log-text\" tabindex=\"0\">{{.Text}}</pre>{{else}}<p class=\"muted\">The retained log is empty.</p>{{end}}\n     {{if .Exit}}<p class=\"muted\">completed with exit {{.Exit}}</p>{{end}}\n   {{else if eq .State \"evicted\"}}\n     <p class=\"muted\">This Run is known, but its log is no longer retained.</p>\n@@ -15,4 +16,4 @@\n     <p>Canopy could not read this Run log.</p>\n     {{if .Error}}<p class=\"muted\">{{.Error}}</p>{{end}}\n   {{end}}\n-</article>\n+</div>\ndiff --git a/templates/page.html b/templates/page.html\nindex d3011f7..4125582 100644\n--- a/templates/page.html\n+++ b/templates/page.html\n@@ -21,6 +21,17 @@\n       {{template \"instance.html\" .Selected}}\n     </main>\n   </div>\n+  <div id=\"log-drawer\" class=\"log-drawer\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"log-drawer-title\" hidden>\n+    <div class=\"log-drawer-backdrop\" data-log-close aria-hidden=\"true\"></div>\n+    <section class=\"log-drawer-panel\" aria-label=\"Run log viewer\">\n+      <header class=\"log-drawer-header\">\n+        <h2 id=\"log-drawer-title\">Run log</h2>\n+        <button type=\"button\" class=\"log-drawer-close\" data-log-close aria-label=\"Close log viewer\">Close</button>\n+      </header>\n+      <div id=\"log-drawer-body\" class=\"log-drawer-body\"></div>\n+    </section>\n+  </div>\n   <script src=\"/static/htmx.min.js\" defer></script>\n+  <script src=\"/static/canopy.js\" defer></script>\n </body>\n </html>\n"}],"isError":false,"timestamp":1788549491170},{"role":"assistant","content":[{"type":"thinking","thinking":"Now I need to review this diff deeply. Let me understand the codebase. The change introduces a slide-over drawer for run logs. Let me examine relevant files: server.go, models, templates, existing CSS variables, htmx handling, routes for /logs, etc.\n\nKey areas to check:\n1. HTMX behavior: log links now have `data-log-open` attribute and `hx-get` and `hx-target=\"#log-drawer-body\"`. The JS click handler intercepts clicks on `[data-log-open]`. If the click is a normal left click (button 0, no modifiers), it calls openDrawer(openLink) and returns. But wait - it returns after openDrawer, but does it prevent default? No, it does NOT call event.preventDefault(). So the click on the anchor will still trigger the browser default navigation to the href, AND htmx will also handle it (hx-get). Let me think.\n\nThe anchor has `href=\"/logs?...` and `hx-get=\"/logs?...`. Normally htmx intercepts the click and issues an AJAX GET, preventing default navigation. But here there is also a document click listener registered. Order of listeners: canopy.js script is loaded with `defer` after htmx.min.js defer. Both defer scripts execute after parsing but in order. htmx binds its click handler at load; canopy.js binds its click handler after. When click happens, htmx's listener and canopy's listener both fire (both on document, bubbling). Order depends on registration; both in bubbling phase at document. htmx registers first, canopy second. So htmx's handler fires first, then canopy's. Actually for document-level listeners, target is element; event bubbles to document; listeners on document fire in registration order (assuming same phase). htmx first → htmx initiates GET and calls preventDefault (for anchor). Then canopy handler fires: finds data-log-open, calls openDrawer, returns. So the htmx AJAX GET still happens, loading content into #log-drawer-body. Good. The drawer opens immediately and shows \"Loading log…\", then htmx swaps content.\n\nBut what if htmx is unavailable (script failed to load, CDN? It's local static/htmx.min.js)? Then clicking would navigate to the log URL (full page) because no preventDefault from canopy.js. That might be okay fallback. But openDrawer would also open a drawer on the current page before navigation. Minor.\n\nWhat about keyboard activation? `data-log-open` links are anchors; pressing Enter triggers a click event with button 0? For keyboard activation, click event has button 0 and no modifiers typically, so openDrawer works. HTMX also handles. Good.\n\nBut accessibility: role dialog with aria-modal true but no focus trap except Tab handling within panel. It focuses close button on open. Escape closes. Tab trap is implemented only when panel open. But focus could move outside via programmatic means or shift+tab at first wraps to last. Good enough.\n\n2. Copy control: uses navigator.clipboard if secure context, else legacyCopy with execCommand. The copy button is in log.html template and appears only when retained and text exists. On click, it finds `.log-pane` and `.log-text`. Fine.\n\nPotential issue: HTMX swaps innerHTML into #log-drawer-body. The content from log.html is a `div.log-pane`. The drawer body already has class log-drawer-body. Good.\n\n3. The old `.log-output` div with hx-preserve removed. Now no inline log output. The `hx-target=\"#log-drawer-body\"` works because the drawer body exists in page template. Good.\n\n4. The drawer is in page.html, which is likely the base template for all pages. Instance page includes page.html via something. Need to check template structure. The test renders page.html directly with PageView{} and expects `id=\"log-drawer\"` etc. Need to confirm page.html defines Selected and includes instance.html.\n\n5. CSS: `.log-drawer` uses `position: fixed; inset: 0; z-index: 50; grid-template-columns: minmax(0,1fr) minmax(22rem,40rem);`. Backdrop grid-column 1/-1 row 1. Panel grid-column 2 row 1. On max-width 560, grid-template-columns 1fr; panel grid-column 1; backdrop display none. Good.\n\nBut check: `.log-drawer` previously was used as a class for the inline log article (`class=\"log-drawer log-output\"`). Now that old article removed, and new fixed overlay uses `.log-drawer`. Fine. But are there other templates or code still referencing `.log-drawer` in old inline form? Let me search.\n\n6. Potential issue: `event.target.closest` can throw if event.target is not an Element (e.g., text node? Actually event.target for click is an Element usually, but could be SVG or Document). `closest` exists on Element. For click target in document, it's Element. Fine. But if event target is not an Element, `event.target.closest` would throw TypeError. Click targets are always Elements in browsers (could be Text? click events target the element). Fine.\n\n7. The JS runs on every page via page.html. It references document.getElementById(\"log-drawer\") which may be null on pages that don't include page.html? It's loaded only on pages using page.html. Is page.html the base template for all pages? There may be other templates (error pages, log standalone page?) that don't have log-drawer but might include canopy.js? canopy.js is loaded only in page.html footer. So drawer() returns null and handlers return early. Fine.\n\n8. The standalone `/logs` route: clicking log link via HTMX loads /logs?instance=&run= which returns log.html fragment. But what if someone navigates directly to /logs?... It likely returns a full page? Let me check server.go. Need to review how /logs responds and whether log.html is used standalone or within page. The old inline approach loaded log.html fragment. The new approach also loads fragment via HTMX. Fine.\n\n9. Check the template change: log.html no longer wraps in `<article id=\"log-{{.RunID}}\" ...>`. The id `log-{{.RunID}}` is removed. But the old hx-preserve on instance rows referenced the inline div; removed. Any tests or code referencing `id=\"log-`? The new test checks strings. Fine.\n\n10. Security: log text is inserted via Go templates, escaped by html/template. Then copy uses textContent (safe). InnerHTML uses static \"Loading log…\". No XSS.\n\n11. `copyText` returns a Promise. In legacy fallback path, `Promise.resolve(legacyCopy(value))` - legacyCopy returns boolean synchronously, so Promise resolves with boolean. Good.\n\nPotential issue: If navigator.clipboard exists and window.isSecureContext, writeText promise rejects (e.g., permission denied) and fallback to legacyCopy. Good.\n\n12. Focus handling on close: restore focus to lastTrigger if it's still in document and focusable? They check `typeof restore.focus === \"function\"`, not that it's focusable. If lastTrigger is an `<a>`, focus works. If it was removed, fallback to `#main-content`. Is `main-content` focusable? Need to check page.html - the main element may not have tabindex. Calling focus() on a non-focusable element does nothing, but no error. So focus may not restore properly if main-content lacks tabindex. That's an accessibility minor issue, not blocking.\n\nActually restore focus: after close, `restore.focus()` where restore = lastTrigger (anchor) or `#main-content`. If lastTrigger is the anchor, it is focusable (a href), fine. If drawer opened programmatically with trigger = null (not the case from click handler), restore main-content maybe not focusable. Minor.\n\n13. Focus trap: It queries focusable elements in panel. `panel` includes backdrop (data-log-close, aria-hidden, a div). The backdrop has `data-log-close` but is a div without tabindex, so not focusable. Focusable selector includes `button, [href], input, select, textarea, [tabindex]`. The close button and copy button (if loaded) and log-text pre with tabindex 0 are focusable. Good. But on open, it focuses close button; content hasn't loaded yet. When HTMX swaps, copy button and pre appear; trap handles Tab.\n\nPotential issue: the backdrop is clickable to close via data-log-close, but it has aria-hidden true. Clicking aria-hidden element as close is okay-ish, but not keyboard accessible. Escape and Close button exist, so fine.\n\n14. HTMX and `hx-target=\"#log-drawer-body\"`: htmx will by default swap innerHTML. Good. But what about `hx-push-url`? Not set; URL stays same. Good.\n\n15. Potential bug: `openDrawer` sets `panel.hidden = false`. The `hidden` attribute vs CSS `.log-drawer[hidden] { display: none; }`. Both hidden attribute default display:none, but CSS explicitly. When hidden false, grid display applies. Good.\n\n16. Is there a `--evergreen-dark` CSS va