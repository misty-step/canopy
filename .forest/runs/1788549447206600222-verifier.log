-bottom: 1px solid var(--line); padding-bottom: .7rem; margin-bottom: .7rem; }\n.card-header h2, .card-header h3 { margin: 0; }\n.muted { color: var(--muted); }\n.error-list { margin: 0; padding-left: 1.2rem; color: var(--danger); }\n.empty { color: var(--muted); font-style: italic; }\n\n.metric-row { display: flex; flex-wrap: wrap; gap: .8rem 1.4rem; margin: 0; }\n.metric { display: grid; gap: .1rem; min-width: 5rem; }\n.metric dt { color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; }\n.metric dd { margin: 0; font-size: 1.2rem; font-weight: 680; }\n\n.data-table-wrap { max-width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; }\n.data-table { width: 100%; border-collapse: collapse; font-size: .88rem; color: var(--ink); }\n.data-table th { color: #354741; font-size: .72rem; font-weight: 750; letter-spacing: .09em; text-align: left; text-transform: uppercase; }\n.data-table th, .data-table td { padding: .65rem .45rem; vertical-align: top; border-bottom: 1px solid var(--line); }\n.data-table tr:last-child td { border-bottom: 0; }\n.data-table td { overflow-wrap: anywhere; color: var(--ink); }\n.data-table .number { text-align: right; font-variant-numeric: tabular-nums; }\n.signal { display: inline-block; padding: .12rem .4rem; border-radius: .25rem; font-size: .7rem; font-weight: 750; letter-spacing: .04em; text-transform: uppercase; }\n.signal.ok { color: var(--fresh); background: #e8f3e9; }\n.signal.stale { color: var(--stale); background: #fff6e4; }\n.signal.error { color: var(--danger); background: #f9e9e6; }\n.signal.unknown { color: var(--unknown); background: #edf0ee; }\n.signal.running { color: var(--evergreen); background: #e2f1e4; }\n\n.log-link { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .8rem; }\n\n.log-drawer {\n  --log-gutter: 1.25rem;\n  position: fixed;\n  inset: 0;\n  z-index: 50;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(22rem, 40rem);