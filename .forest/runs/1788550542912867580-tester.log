   </section>\n    {{else}}\n      <div class=\"card-grid\">\n        <section class=\"card card-third\" aria-labelledby=\"overview-title\">\n          <div class=\"card-header\"><h2 id=\"overview-title\">Overview</h2><span class=\"signal {{.Freshness}}\">{{.Freshness}}</span></div>\n          <dl class=\"metric-row\">\n            <div class=\"metric\"><dt>Kernel</dt><dd>{{if .KernelKnown}}{{if .KernelRunning}}running{{else}}stopped{{end}}{{else}}unknown{{end}}</dd></div>\n            <div class=\"metric\"><dt>Live runs</dt><dd>{{.ActiveRuns}}</dd></div>\n            <div class=\"metric\"><dt>Build</dt><dd class=\"mono\">{{.Version}}</dd></div>\n          </dl>\n        </section>\n        <section class=\"card card-third\" aria-labelledby=\"audit-title\">\n          <div class=\"card-header\"><h2 id=\"audit-title\">Audit trust</h2><span class=\"signal {{.Audit.TrustClass}}\">{{.Audit.Trust}}</span></div>\n          <dl class=\"metric-row\">\n            <div class=\"metric\"><dt>Result</dt><dd>{{if .Audit.LastResult}}{{.Audit.LastResult}}{{else}}unknown{{end}}</dd></div>\n            <div class=\"metric\"><dt>Audited</dt><dd class=\"mono\">{{if .Audit.AuditedMaster}}{{.Audit.AuditedMaster}}{{else}}unknown{{end}}</dd></div>\n          </dl>\n          {{if .Audit.Violations}}<ul class=\"error-list\">{{range .Audit.Violations}}<li>{{.}}</li>{{end}}</ul>{{end}}\n        </section>\n        <section class=\"card card-third\" aria-labelledby=\"config-summary-title\">\n          <div class=\"card-header\"><h2 id=\"config-summary-title\">Configuration</h2><span class=\"muted mono\">{{.Config.Primary}}</span></div>\n          <p class=\"muted\">{{if .Config.PrimarySource}}primary from {{.Config.PrimarySource}}{{else}}primary declaration{{end}}</p>\n          {{if .Config.Scope.Label}}<p><strong>Scope:</strong> {{.Config.Scope.Label}}</p>{{end}}\n          {{if .Config.Scope.BranchPrefix}}<p><strong>Branch:</strong> <span class=\"mono\">{{.Config.Scope.BranchPrefix}}</span