,\n        \"spec\": \"Align README.md with the current implementation: document systemd unit discovery (forest@*.service), checkout-local discovery conventions, configuration precedence (CLI flag \\u003e canopy.json \\u003e zero-config discovery), and empty-state requirements.\"\n      }\n    ],\n    \"created_at\": \"2026-09-03T22:01:07.217Z\",\n    \"updated_at\": \"2026-09-04T18:09:57.811Z\",\n    \"derived\": {\n      \"terminal\": false,\n      \"waiting\": false,\n      \"open\": true,\n      \"live\": true,\n      \"takeable\": false\n    }\n  },\n  {\n    \"id\": \"canopy-expand-checkout-discovery\",\n    \"title\": \"Discover managed repositories with forest.yaml without requiring pre-existing .forest directory\",\n    \"spec\": \"Enhance DiscoverLocalInstances in discovery.go to detect checkouts declaring forest.yaml and resolve executable forest binaries from PATH or factory root when repo-local ./forest binary is uncompiled.\",\n    \"repo\": \"misty-step/canopy\",\n    \"blocked_by\": [],\n    \"lease\": null,\n    \"ask\": null,\n    \"proof\": \"ca9e23795abebbe11ec519332a79b9c1d96d9ae2\",\n    \"abandoned\": false,\n    \"notes\": [\n      {\n        \"at\": \"2026-09-04T18:25:46.29Z\",\n        \"by\": \"forest-misty-step/iron-forest\",\n        \"text\": \"took\"\n      },\n      {\n        \"at\": \"2026-09-04T19:02:10.586Z\",\n        \"by\": \"forest-misty-step/iron-forest\",\n        \"text\": \"done: ca9e23795abebbe11ec519332a79b9c1d96d9ae2\"\n      }\n    ],\n    \"created_by\": \"none\",\n    \"promoted_by\": \"none\",\n    \"promoted_at\": \"2026-09-03T22:01:07.373Z\",\n    \"promotions\": [\n      {\n        \"at\": \"2026-09-03T22:01:07.373Z\",\n        \"by\": \"none\",\n        \"spec\": \"Enhance DiscoverLocalInstances in discovery.go to detect checkouts declaring forest.yaml and resolve executable forest binaries from PATH or factory root when repo-local ./forest binary is uncompiled.\"\n      }\n    ],\n    \"created_at\": \"2026-09-