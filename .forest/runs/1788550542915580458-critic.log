{"type":"tool_execution_end","toolCallId":"call_8a7e2b90ab7b4e10b408972c","toolName":"read","result":{"content":[{"type":"text","text":"<aside class=\"fleet-rail\" id=\"fleet\"\n  hx-get=\"/fragments/fleet\"\n  hx-trigger=\"every 10s [document.hidden === false], canopy-selection from:body\"\n  hx-target=\"#fleet\"\n  hx-swap=\"outerHTML\">\n  <a class=\"brand\" href=\"/\" aria-label=\"Canopy home\">\n    <span class=\"brand-mark\" aria-hidden=\"true\">⌁</span>\n    <span>\n      <span class=\"brand-name\">Canopy</span>\n      <span class=\"brand-caption\">Iron Forest view</span>\n    </span>\n  </a>\n  <p class=\"rail-heading\">Fleet</p>\n  {{if .Instances}}\n    <nav aria-label=\"Forest instances\">\n      <ul class=\"instance-list\">\n        {{range .Instances}}\n          <li>\n            <a class=\"instance-link\" href=\"/?instance={{.ID}}\"\n              hx-get=\"/fragments/instance?instance={{.ID}}\" hx-target=\"#instance-panel\" hx-push-url=\"/?instance={{.ID}}\"\n              aria-current=\"{{if .IsSelected}}true{{else}}false{{end}}\">\n              <span class=\"state-dot {{.Freshness}}\" aria-hidden=\"true\"></span>\n              <span class=\"instance-name\">\n                <span class=\"instance-title-row\">\n                  <span class=\"instance-label\">{{if .Label}}{{.Label}}{{else}}{{.ID}}{{end}}</span>\n                  {{if .KernelKnown}}\n                    <span class=\"pill-badge {{if .KernelRunning}}running{{else}}stopped{{end}}\">{{if .KernelRunning}}live{{else}}stopped{{end}}</span>\n                  {{end}}\n                </span>\n                <span class=\"instance-meta\">\n                  {{if .Repo}}{{.Repo}}{{else}}{{.Freshness}}{{end}}\n                  {{if gt .ActiveRuns 0}} · <strong class=\"accent-text\">{{.ActiveRuns}} running</strong>{{end}}\n                </span>\n              </span>\n            </a>\n          </li>\n        {{end}}\n      </ul>\n    </nav>\n  {{else}}\n    <p class=\"rail-empty\">No instances configured.</p>\n  {{end}}\n</aside>\n"}]},"isError":false}
{"type":"tool_execution_end","toolCallId":"call_f5fc2657e20a430ba3b34113","toolName":"read","result":{"content":[{"type":"text","text":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Canopy · Iron Forest visibility</title>\n  <link rel=\"stylesheet\" href=\"/static/canopy.css\">\n</head>\n<body>\n  <div class=\"app-shell\">\n    {{template \"fleet.html\" .}}\n    <main class=\"page-content\" id=\"main-content\">\n      <header class=\"page-header\">\n        <div>\n          <p class=\"eyebrow\">Read-only operations surface</p>\n          <h1>Canopy</h1>\n          <p class=\"lede\">A quiet, external view of the work your Iron Forest instances are doing now and what they last proved.</p>\n        </div>\n        <p class=\"muted mono\">forest.cli.v2</p>\n      </header>\n      {{template \"instance.html\" .Selected}}\n    </main>\n  </div>\n  <script src=\"/static/htmx.min.js\" defer></script>\n</body>\n</html>\n"}]},"isError":false}
{"type":"tool_execution_end","toolCallId":"call_cc5a82da9c2d41f78253d999","toolName":"read","result":{"content":[{"type":"text","text":"<section class=\"instance-panel\" id=\"instance-panel\"\n  {{if .ID}}hx-get=\"/fragments/instance?instance={{.ID}}\" hx-trigger=\"every 2s [document.hidden === false]\" hx-target=\"#instance-panel\" hx-swap=\"outerHTML\"{{end}}>\n  {{if .ID}}\n    <header class=\"identity\">\n      <div>\n        <p class=\"eyebrow\">Selected instance</p>\n        <h2>{{if .Label}}{{.Label}}{{else}}{{.ID}}{{end}}</h2>\n        <p class=\"identity-meta\"><span class=\"mono\">{{.ID}}</span>{{if .Host}} · {{.Host}}{{end}}{{if .Repo}} · {{.Repo}}{{end}}</p>\n      </div>\n      <span class=\"status-badge {{.Freshness}}\">{{.Freshness}}</span>\n      {{if .LastObserved}}<span class=\"identity-meta\">last observed {{.LastObserved}}</span>{{end}}\n    </header>\n\n    {{if .Errors}}\n      <section class=\"card card-wide\" aria-labelledby=\"instance-errors\">\n        <div class=\"card-header\"><h2 id=\"instance-errors\">Collection warnings</h2><span class=\"signal error\">attention</span></div>\n        <ul class=\"error-list\">\n          {{range .Errors}}<li>{{.}}</li>{{end}}\n        </ul>\n      </section>\n    {{end}}\n\n    {{if eq .Freshness \"unknown\"}}\n      <section class=\"card card-wide\" aria-labelledby=\"waiting-title\">\n        <div class=\"card-header\"><h2 id=\"waiting-title\">Waiting for first observation</h2><span class=\"signal unknown\">unknown</span></div>\n        <p class=\"muted\">No successful snapshot is available yet. Canopy will keep trying without treating this instance as healthy.</p>\n      </section>\n    {{else}}\n      <div class=\"card-grid\">\n        <section class=\"card card-third\" aria-labelledby=\"overview-title\">\n          <div class=\"card-header\"><h2 id=\"overview-title\">Overview</h2><span class=\"signal {{.Freshness}}\">{{.Freshness}}</span></div>\n          <dl class=\"metric-row\">\n            <div class=\"metric\"><dt>Kernel</dt><dd>{{if .KernelKnown}}{{if .KernelRunning}}running{{else}}stopped{{end}}{{else}}unknown{{end}}</dd></div>\n            <div class=\"metric\"><dt>Live runs</dt><dd>{{.ActiveRuns}}</dd></div>\n            <div class=\"metric\"><dt>Build</dt><dd class=\"mono\">{{.Version}}</dd></div>\n          </dl>\n        </section>\n        <section class=\"card card-third\" aria-labelledby=\"audit-title\">\n          <div class=\"card-header\"><h2 id=\"audit-title\">Audit trust</h2><span class=\"signal {{.Audit.TrustClass}}\">{{.Audit.Trust}}</span></div>\n          <dl class=\"metric-row\">\n            <div class=\"metric\"><dt>Result</dt><dd>{{if .Audit.LastResult}}{{.Audit.LastResult}}{{else}}unknown{{end}}</dd></div>\n            <div class=\"metric\"><dt>Audited</dt><dd class=\"mono\">{{if .Audit.AuditedMaster}}{{.Audit.AuditedMaster}}{{else}}unknown{{end}}</dd></div>\n          </dl>\n          {{if .Audit.Violations}}<ul class=\"error-list\">{{range .Audit.Violations}}<li>{{.}}</li>{{end}}</ul>{{end}}\n        </section>\n        <section class=\"card card-third\" aria-labelledby=\"config-summary-title\">\n          <div class=\"card-header\"><h2 id=\"config-summary-title\">Configuration</h2><span class=\"muted mono\">{{.Config.Primary}}</span></div>\n          <p class=\"muted\">{{if .Config.PrimarySource}}primary from {{.Config.PrimarySource}}{{else}}primary declaration{{end}}</p>\n          {{if .Config.Scope.Label}}<p><strong>Scope:</strong> {{.Config.Scope.Label}}</p>{{end}}\n          {{if .Config.Scope.BranchPrefix}}<p><strong>Branch:</strong> <span class=\"mono\">{{.Config.Scope.BranchPrefix}}</span></p>{{end}}\n          {{if .Config.Scope.Subjects}}<p><strong>Subjects:</strong> {{len .Config.Scope.Subjects}}</p>{{end}}\n        </section>\n\n        <section class=\"card card-wide\" aria-labelledby=\"live-title\">\n          <div class=\"card-header\"><h2 id=\"live-title\">Live work</h2><span class=\"muted\">{{.ActiveRuns}} active</span></div>\n          {{if .LiveRuns}}\n            <div class=\"data-table-wrap\"><table class=\"data-table\"><thead><tr><th>Run</th><th>Agent</th><th>Started</th><th>Elapsed</th><th>Logs</th></tr></thead><tbody>\n              {{range .LiveRuns}}\n                <tr><td class=\"mono\">{{.RunID}}</td><td>{{if .Agent}}{{.Agent}}{{else}}legacy / unnamed{{end}}</td><td class=\"mono\">{{.StartedAt}}</td><td>{{.Elapsed}}</td><td><a class=\"log-link\" href=\"/logs?instance={{$.ID}}&amp;run={{.RunID}}\" hx-get=\"/logs?instance={{$.ID}}&amp;run={{.RunID}}\" hx-target=\"next .log-output\" hx-swap=\"outerHTML\">open log</a><div id=\"log-{{.RunID}}\" class=\"log-output muted\" hx-preserve=\"true\">on demand</div></td></tr>\n              {{end}}\n            </tbody></table></div>\n          {{else}}<p class=\"empty\">No live runs reported.</p>{{end}}\n        </section>\n\n        <section class=\"card card-half\" aria-labelledby=\"trigger-title\">\n          <div class=\"card-header\"><h2 id=\"trigger-title\">Trigger matrix</h2><span class=\"muted\">poll vs run</span></div>\n          {{if .Triggers}}\n            <div class=\"data-table-wrap\">\n            <table class=\"data-table\"><thead><tr><th>Agent</th><th>Poll</th><th>Run</th><th>Errors</th></tr></thead><tbody>\n              {{range .Triggers}}\n                <tr><td>{{if .Name}}{{.Name}}{{else}}legacy / unnamed{{end}}</td><td><span class=\"signal {{.PollStatus}}\">{{.PollStatus}}</span>{{if .PollError}}<br><span class=\"muted\">{{.PollError}}</span>{{end}}</td><td><span class=\"signal {{.RunStatus}}\">{{.RunStatus}}</span>{{if .RunError}}<br><span class=\"muted\">{{.RunError}}</span>{{end}}</td><td>{{.ConsecutiveErrors}}</td></tr>\n              {{end}}\n            </tbody></table>\n            </div>\n          {{else}}<p class=\"empty\">No trigger state reported.</p>{{end}}\n        </section>\n\n        <section class=\"card card-half\" aria-labelledby=\"recent-title\">\n          <div class=\"card-header\"><h2 id=\"recent-title\">Recent runs</h2><span class=\"muted\">newest first</span></div>\n          {{if .RecentRuns}}\n            <div class=\"data-table-wrap\">\n            <table class=\"data-table\"><thead><tr><th>Run</th><th>Agent</th><th>Outcome</th><th>Duration</th><th>Logs</th></tr></thead><tbody>\n              {{range .RecentRuns}}\n                <tr><td class=\"mono\">{{.RunID}}</td><td>{{if .Agent}}{{.Agent}}{{else}}legacy / unnamed{{end}}</td><td><span class=\"signal {{if eq .Status \"passed\"}}ok{{else}}error{{end}}\">{{.ExitLabel}}</span>{{if .Error}}<br><span class=\"muted\">{{.Error}}</span>{{end}}</td><td>{{.Duration}}</td><td><a class=\"log-link\" href=\"/logs?instance={{$.ID}}&amp;run={{.RunID}}\" hx-get=\"/logs?instance={{$.ID}}&amp;run={{.RunID}}\" hx-target=\"next .log-output\" hx-swap=\"outerHTML\">open</a><div id=\"log-{{.RunID}}\" class=\"log-output muted\" hx-preserve=\"true\">on demand</div></td></tr>\n              {{end}}\n            </tbody></table>\n            </div>\n          {{else}}<p class=\"empty\">No recent runs reported.</p>{{end}}\n        </section>\n\n        <section class=\"card card-wide\" aria-labelledby=\"ledger-title\">\n          <div class=\"card-header\">\n            <h2 id=\"ledger-title\">Ledger agents</h2>\n            {{if .HasLedger}}\n              <span class=\"muted\">{{.LedgerRuns}} runs · {{.LedgerPassRate}} pass rate</span>\n            {{else}}\n              <span class=\"signal unknown\">unsupported</span>\n            {{end}}\n          </div>\n          {{if .HasLedger}}\n            {{if .Agents}}\n              <div class=\"data-table-wrap\">\n              <table class=\"data-table\"><thead><tr><th>Agent</th><th class=\"number\">Runs</th><th class=\"number\">Pass rate</th><th class=\"number\">P50</th><th class=\"number\">P95</th><th class=\"number\">Tokens in</th><th class=\"number\">Tokens out</th></tr></thead><tbody>\n                {{range .Agents}}\n                  <tr><td>{{if .Agent}}{{.Agent}}{{else}}legacy / unnamed{{end}}</td><td class=\"number\">{{.Runs}}</td><td class=\"number\">{{.PassRateLabel}}</td><td class=\"number\">{{.DurationP50Label}}</td><td class=\"number\">{{.DurationP95Label}}</td><td class=\"number\">{{.TokensIn}}</td><td class=\"number\">{{.TokensOut}}</td></tr>\n                {{end}}\n              </tbody></table>\n              </div>\n            {{else}}<p class=\"empty\">No Ledger agents recorded.</p>{{end}}\n          {{else}}\n            <p class=\"empty\">This Iron Forest build does not export status.ledger aggregates.</p>\n          {{end}}\n        </section>\n        <section class=\"card card-wide\" aria-labelledby=\"declarations-title\">\n          <div class=\"card-header\"><h2 id=\"declarations-title\">Declarations</h2><span class=\"muted\">configuration snapshot</span></div>\n          {{if .Config.Declarations}}\n            <div class=\"data-table-wrap\">\n            <table class=\"data-table\"><thead><tr><th>Name</th><th>Model</th><th>Model source</th><th>Tools</th><th>Watchdog</th></tr></thead><tbody>\n              {{range .Config.Declarations}}\n                <tr><td>{{if .Name}}{{.Name}}{{else}}legacy / unnamed{{end}}</td><td class=\"mono\">{{.Model}}</td><td>{{.ModelSource}}</td><td>{{range $index, $tool := .Tools}}{{if $index}}, {{end}}{{$tool}}{{end}}</td><td>{{if .MaxDuration}}{{.MaxDuration}}s{{else}}unbounded{{end}}</td></tr>\n              {{end}}\n            </tbody></table>\n            </div>\n          {{else}}<p class=\"empty\">No declarations reported.</p>{{end}}\n        </section>\n      </div>\n    {{end}}\n  {{else}}\n    <section class=\"card card-wide\" aria-labelledby=\"empty-title\"><div class=\"card-header\"><h2 id=\"empty-title\">No instance selected</h2><span class=\"signal unknown\">unknown</span></div><p class=\"empty\">Add an instance to the inventory to begin observing it.</p></section>\n  {{end}}\n</section>\n"}]},"isError":false}
